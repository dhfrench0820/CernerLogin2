# Oracle Health Millennium system-account configuration
CERNER_AUTH_METHOD=jwt
CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=
CERNER_TOKEN_URL=
CERNER_FHIR_BASE_URL=
CERNER_PRIVATE_KEY_PATH=private_key.pem
CERNER_KEY_ID=
CERNER_SCOPES=system/Patient.read
CERNER_PATIENT_ID=

# Optional (Go duration syntax)
CERNER_HTTP_TIMEOUT=15s

# Set to true only when deliberately running against a configured sandbox
CERNER_INTEGRATION_TEST=false
